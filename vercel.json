{
  "version": 2,
  "builds": [
    {
      "src": "backendObfuscated/server.js",
      "use": "@vercel/node"
    },
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": { 
        "distDir": "build",
        "installCommand": "npm install --legacy-peer-deps && npm run build"
      }
    }
  ],
  "routes": [
    {
      "source": "/api/(.*)",
      "destination": "backendObfuscated/server.js"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "frontend/index.html"
    }
  ]
}
