{
  "$schema": "https://vercel.sh",
  "services": {
    "backendobfuscated": {
      "root": "backendObfuscated",
      "framework": "express",
      "installCommand": "npm install --legacy-peer-deps"
    },
    "frontend": {
      "root": "frontend",
      "framework": "create-react-app",
      "installCommand": "npm install --legacy-peer-deps",
      "routes": [
        { "handle": "filesystem" },
        { "src": "/(.*)", "dest": "/index.html" }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    }
  ]
}
