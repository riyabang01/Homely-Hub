{
  "$schema": "https://vercel.sh",
  "services": {
    "backendobfuscated": {
      "root": "backendObfuscated",
      "framework": "express",
      "installCommand": "npm install --legacy-peer-deps"
    },
    "frontend": {
      "root": "frontend",
      "framework": "create-react-app",
      "installCommand": "npm install --legacy-peer-deps"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backendobfuscated"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
