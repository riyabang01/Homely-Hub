{
  "version": 2,
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "build" }
    },
    {
      "src": "backendObfuscated/server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "backendObfuscated/server.js"
    },
    {
      "src": "/((?!api/).*)",
      "dest": "frontend/$1",
      "check": true
    },
    {
      "src": "/((?!api/).*)",
      "dest": "frontend/index.html"
    }
  ]
}
