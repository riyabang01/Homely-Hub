{
  "$schema": "https://vercel.sh",
  "services": {
    "backendobfuscated": {
      "root": "backendObfuscated",
      "framework": "express",
      "entrypoint": "server.js",
      "installCommand": "npm install --legacy-peer-deps"
    },
    "frontend": {
      "root": "frontend",
      "framework": "create-react-app",
      "installCommand": "npm install --legacy-peer-deps"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": {
        "service": "backendobfuscated"
      }
    },
    {
      "source": "/((?!api/).*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
